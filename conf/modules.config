/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // A selector instead of a plain process.container: nf-schema's paramsSummaryLog casts
    // workflow.container to a Map and fails on the String a single global container gives.
    withName: '.*' {
        container = 'docker.io/nicotru/drevalpy-plugins:2.0.0-59c3bf69'
    }

    // The default image has the CPU build of torch; GPU tasks need the CUDA build. The pattern must
    // match the fully qualified name, else the '.*' selector above takes precedence.
    withName: '.*:SINGLE_GPU' {
        container = { workflow.profile.contains('gpu') ? 'docker.io/nicotru/drevalpy-plugins:2.0.0-59c3bf69-cu130' : 'docker.io/nicotru/drevalpy-plugins:2.0.0-59c3bf69' }
    }

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: SPLIT {
        publishDir = [
            path: { "${params.outdir}/split" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: DESCRIBE {
        publishDir = [
            path: { "${params.outdir}/describe" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SINGLE_GPU|SINGLE_CPU' {
        publishDir = [
            path: { "${params.outdir}/single/${model}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: AGGREGATE {
        publishDir = [
            path: { "${params.outdir}/aggregate" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: REPORT {
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
